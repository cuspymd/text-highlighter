{
  "name": "text-highlighter",
  "version": "1.0.0",
  "description": "A Chrome extension for text highlighting",
  "main": "background.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --no-cache",
    "deploy": "npm run deploy:chrome && npm run deploy:firefox",
    "deploy:chrome": "node ./scripts/deploy.cjs",
    "deploy:firefox": "node ./scripts/deploy.cjs firefox",
    "version-deploy": "node ./scripts/version-deploy.cjs",
    "link-skills": "node ./scripts/link-skills.cjs",
    "test:e2e:firefox": "npm run deploy:firefox && node --test \"e2e-tests-firefox/*.test.js\""
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "archiver": "^7.0.1",
    "geckodriver": "^6.1.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.52.0",
    "selenium-webdriver": "^4.48.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e-tests/",
      "<rootDir>/e2e-tests-firefox/"
    ]
  }
}
